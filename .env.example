# ── Supabase ───────────────────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Auth ───────────────────────────────────────────────────────────────
# Comma-separated super-admin emails (access to the /admin user dashboard).
# Server-only.
ADMIN_EMAILS=laudes.michael@gmail.com

# ── Extraction provider ────────────────────────────────────────────────
# Primary vision/LLM extractor (PRD §4.9). Server-only — never commit.
OPENAI_API_KEY=sk-...
# Model used for structured invoice extraction
OPENAI_VISION_MODEL=gpt-4o
# Optional: point at any OpenAI-compatible endpoint (OpenRouter, Groq, Together,
# Azure, local vLLM/Ollama). Leave unset for the OpenAI API.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Optional: force "json_object" if the model lacks strict json_schema support.
# Default tries json_schema and falls back to json_object automatically.
# OPENAI_RESPONSE_FORMAT=json_schema

# ── Eval verification portal ───────────────────────────────────────────
# Passphrase that encrypts the deployable portal (eval/portal/seal.mjs) and
# unlocks it at spendsilo-verify.vercel.app. Set it here for reproducible
# re-seals; a --passcode flag or shell env var overrides it. Local-only —
# never committed (.env.local is gitignored). Strong = real protection.
# PORTAL_PASSCODE=pick-something-memorable

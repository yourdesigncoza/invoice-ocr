# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local dev/QA artifacts (root-level screenshots; public/ assets are unaffected)
/.playwright-mcp/
/*.png

# model-eval output + gold labels — contain data from real client receipts
/eval/results.json
/eval/results/
/eval/labels.json
__pycache__/
*.pyc

# exported CSVs (real invoice data) + editor lock files
/*.csv
.~lock.*#

# client sample data — real supplier invoices, kept out of the repo.
# Drop a hand-picked, de-identified subset into tests/sample_invoices/ instead.
/WhatsApp*/
/WhatsApp*.zip

# typescript
*.tsbuildinfo
next-env.d.ts
